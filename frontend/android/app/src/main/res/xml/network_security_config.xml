<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <!--
    Physical-device debug APKs use src/debug (all cleartext). This main file
    is for release / emulator. npm scripts may inject a LAN domain here for
    cap:dev — do not commit a machine-specific IP. Play AAB strips LAN domains.
  -->
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="true">10.0.2.2</domain>
    <domain includeSubdomains="true">localhost</domain>
  </domain-config>
</network-security-config>
