{
  "name": "grocerysync-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest",
    "cap:sync": "node scripts/patch-capacitor-proguard.js && cap sync",
    "cap:dev": "node scripts/patch-capacitor-proguard.js && node scripts/cap-dev.js",
    "cap:run:android:dev": "node scripts/patch-capacitor-proguard.js && node scripts/cap-dev.js --run-android",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "cap:run:android": "node scripts/patch-capacitor-proguard.js && cap run android",
    "cap:run:ios": "cap run ios",
    "build:mobile": "node scripts/patch-capacitor-proguard.js && vite build && cap sync",
    "assets:generate": "node scripts/generate-assets.js && npx capacitor-assets generate --iconBackgroundColor '#ffffff' --splashBackgroundColor '#ffffff' --ios --android",
    "postinstall": "node scripts/patch-capacitor-proguard.js",
    "ios:16": "npx cap run ios --target-name='iPhone 16 Pro'",
    "ios:se": "npx cap run ios --target-name='iPhone SE'",
    "ios:ipad": "npx cap run ios --target-name='iPad Air 11-inch (M2)'"
  },
  "dependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/app": "^8.0.1",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.1.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1",
    "@capawesome/capacitor-google-sign-in": "^0.1.1",
    "@capgo/inappbrowser": "^8.1.23",
    "@supabase/supabase-js": "^2.97.0",
    "axios": "^1.7.0",
    "capacitor-secure-storage-plugin": "^0.13.0",
    "date-fns": "^3.0.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.575.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.0",
    "vite": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
