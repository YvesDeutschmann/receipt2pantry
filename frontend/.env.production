# Production API URL for release builds (Vite production mode).
# Loaded by `vite build` / `npm run build:mobile` / `npm run build:play-aab`.
# Do not put secrets here — only VITE_* vars safe for client bundles.
# Local LAN URLs belong in .env.local (gitignored), never here.
VITE_API_BASE_URL=https://api.meald.app/api
