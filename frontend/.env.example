# Supabase (Vite requires VITE_ prefix for client-side env vars)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Sign-In: Web Client ID from Google Cloud Console (OAuth 2.0 → Web application)
# Required for native Android/iOS Google Sign-In via @capawesome/capacitor-google-sign-in
VITE_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Optional: Test user for local dev - enables "Dev: Sign in as Test User" button
# Only set these in .env.local (gitignored); never commit real credentials
# VITE_TEST_USER_EMAIL=
# VITE_TEST_USER_PASSWORD=
