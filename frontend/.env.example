# Android LAN dev machine (physical device → your PC over HTTP).
# Debug APKs allow all cleartext via src/debug. Scripts also auto-detect the LAN
# IPv4 and write VITE_API_BASE_URL on `build:mobile` / `cap:dev`.
# Optional override if auto-detect picks the wrong adapter:
# ANDROID_DEV_LAN_IP=192.168.1.42
# SKIP_ANDROID_LAN_ENV=1

# Backend API URL — `build:mobile` and `cap:dev` write this to .env.local as
# http://<lan-ip>:5000/api. Play AAB forces frontend/.env.production:
#   VITE_API_BASE_URL=https://api.meald.app/api
# VITE_API_BASE_URL=https://api.meald.app/api

# Dev only: show Settings → Dev Tools (API override / ngrok sync UI) in non-DEV builds (e.g. TestFlight).
# See frontend/MOBILE_SETUP.md — ngrok section. Set in .env.local; do not commit enabled for production App Store.
# VITE_ENABLE_DEV_SETTINGS=1

# Feature flags (default off). Meal planner deferred from MVP — set to 1 to re-enable locally.
# VITE_FEATURE_MEAL_PLANNER=1
# Email/password auth deferred from MVP (OAuth-only beta) — set to 1 to re-enable locally.
# VITE_FEATURE_EMAIL_AUTH=1

# Supabase (Vite requires VITE_ prefix for client-side env vars)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# For web OAuth (e.g. Google in the browser), add your origin + /auth as a redirect URL in the
# Supabase Dashboard (Authentication → URL Configuration). iOS uses native Sign in with Apple (see MOBILE_SETUP.md).

# Google Sign-In: Web Client ID from Google Cloud Console (OAuth 2.0 → Web application)
# Required for native Android/iOS Google Sign-In via @capawesome/capacitor-google-sign-in
VITE_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Optional: Test user for local dev - enables "Dev: Sign in as Test User" button
# Only set these in .env.local (gitignored); never commit real credentials
# VITE_TEST_USER_EMAIL=
# VITE_TEST_USER_PASSWORD=

# GlitchTip Cloud / Sentry-compatible error monitoring (set in CI/production build secrets)
# Shape: https://<key>@app.glitchtip.com/<project-id> (hosted free tier for beta)
# Self-host later: https://<key>@errors.yourdomain.com/<project-id>
# VITE_SENTRY_DSN=https://<key>@app.glitchtip.com/<project-id>
# VITE_APP_RELEASE is injected at build time from git SHA by vite.config.js (override optional)
