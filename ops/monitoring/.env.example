# GlitchTip self-hosted stack — DEFERRED for beta (use GlitchTip Cloud at app.glitchtip.com).
# Copy to .env and fill in secrets before `docker compose up` only if self-hosting later.

# Postgres credentials (used by compose and DATABASE_URL)
POSTGRES_USER=glitchtip
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=glitchtip

# Django / GlitchTip
SECRET_KEY=change-me-long-random-secret-key
DATABASE_URL=postgresql://glitchtip:change-me-strong-db-password@postgres:5432/glitchtip
REDIS_URL=redis://redis:6379/0

# Public URL users and SDKs reach (HTTPS in production)
GLITCHTIP_DOMAIN=https://errors.example.com
GLITCHTIP_PORT=8000

# Data minimization: auto-delete events after N days
GLITCHTIP_MAX_EVENT_LIFE_DAYS=90

# Lock down self-service signup; create users via admin UI or CLI
ENABLE_OPEN_USER_REGISTRATION=false

# Outbound email for alerts (use smtp:// in production)
DEFAULT_FROM_EMAIL=errors@example.com
EMAIL_URL=smtp://user:pass@smtp.example.com:587

CELERY_WORKER_CONCURRENCY=2
